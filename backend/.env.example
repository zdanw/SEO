# ============== 应用配置 ==============
APP_NAME=SEO Platform
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-strong-random-string-please-change-it
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============== 数据库 PostgreSQL + TimescaleDB ==============
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=seo
DB_PASSWORD=seo_dev_pass
DB_NAME=seo_platform
DATABASE_URL=postgresql+psycopg2://seo:seo_dev_pass@127.0.0.1:5432/seo_platform

# ============== Redis / Celery ==============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ============== 大模型 AI（必须使用 DeepSeek）==============
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=120

# ============== SERP 抓取（ScrapingBee 优先，未配置则回退代理池 / Mock）==============
# ScrapingBee Google Search API：https://www.scrapingbee.com/documentation/google-api/
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_TIMEOUT=60
SCRAPINGBEE_PAGES=3

# 传统住宅代理（ScrapingBee 未配置时使用）
PROXY_PROVIDER=smartproxy
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENDPOINT=
# 多个代理用逗号分隔，例如 http://user:pass@ip1:port,http://user:pass@ip2:port
PROXY_LIST=

# ============== 邮件 / 告警 ==============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=seo-platform@example.com
ALERT_EMAIL_TO=admin@example.com

FRONTEND_URL=http://127.0.0.1:5173

# ============== Zernio（Reddit 账号管理 / 发帖 / 评论 / 搜索）==============
# API Key 仅在前端「社交账号」页面添加（写入 zernio_api_keys），不要写进 .env。
# Reddit 账号在 https://zernio.com 绑定；本系统添加 Key 后点「同步账号」。
ZERNIO_API_BASE=https://zernio.com/api/v1
ZERNIO_TIMEOUT=30
