# ============== 应用配置 ==============
APP_NAME=SEO Platform
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-strong-random-string-please-change-it
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============== 数据库 PostgreSQL + TimescaleDB ==============
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=seo
DB_PASSWORD=seo_dev_pass
DB_NAME=seo_platform
DATABASE_URL=postgresql+psycopg2://seo:seo_dev_pass@127.0.0.1:5432/seo_platform

# ============== Redis / Celery ==============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ============== 大模型 AI（必须使用 DeepSeek）==============
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=120

# ============== SERP 抓取（ScrapingBee 优先，未配置则回退代理池 / Mock）==============
# ScrapingBee Google Search API：https://www.scrapingbee.com/documentation/google-api/
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_TIMEOUT=60
SCRAPINGBEE_PAGES=3
SERP_BENCHMARK_TOP_N=5
SERP_BENCHMARK_REGION=us

# 传统住宅代理（ScrapingBee 未配置时使用）
PROXY_PROVIDER=smartproxy
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENDPOINT=
# 多个代理用逗号分隔，例如 http://user:pass@ip1:port,http://user:pass@ip2:port
PROXY_LIST=

# ============== PulseForge 社交平台 ==============
PULSEFORGE_API_BASE=
PULSEFORGE_API_KEY=
PULSEFORGE_TIMEOUT=30

# ============== 邮件 / 告警 ==============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=seo-platform@example.com
ALERT_EMAIL_TO=admin@example.com

# ============== Google Search Console OAuth ==============
# Google Cloud Console → 启用 Search Console API → 创建 OAuth Web 客户端
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/gsc/oauth/callback
FRONTEND_URL=http://127.0.0.1:5173

# ============== Reddit OAuth（Reddit 运营：子版块发帖 + 评论）==============
# 1. https://www.reddit.com/prefs/apps → create app → type "web app"
# 2. Redirect URI 必须与 REDDIT_REDIRECT_URI 完全一致
# 3. REDDIT_USER_AGENT 格式：平台名/版本 (by /u/your_reddit_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/reddit/oauth/callback
REDDIT_USER_AGENT=SEOPlatform/1.0 (by /u/your_reddit_username)

# ============== PageSpeed Insights API（URL 抓取 CWV 真实测量）==============
# Google Cloud Console → 启用 PageSpeed Insights API → 创建 API Key
# 可与 GSC 使用同一 Google Cloud 项目，但需单独创建 API Key（非 OAuth 客户端）
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT=90
PAGESPEED_STRATEGY=mobile

# ============== 对象存储（可选）==============
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=seo-platform
